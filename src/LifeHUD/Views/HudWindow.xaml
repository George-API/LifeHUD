<Window x:Class="LifeHUD.Views.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Life HUD"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        Left="0" Top="0" Width="1200" Height="108"
        FontFamily="{StaticResource TextFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!-- Keep a real (captioned) frame for DWM composition, but render no non-client area at all. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource HudTintBrush}">
        <Border x:Name="EdgeLine" BorderBrush="{DynamicResource HudEdgeBrush}" IsHitTestVisible="False" />
        <Grid x:Name="Host" />
    </Grid>
</Window>
