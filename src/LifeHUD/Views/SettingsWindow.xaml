<Window x:Class="LifeHUD.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Life HUD Settings"
        Width="720" Height="820" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/LifeHUD.ico"
        FontFamily="{StaticResource TextFont}">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,26,0,8" />
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="62" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="LayoutChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GalleryHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,6,0,8" />
        </Style>

        <!-- A theme swatch: a miniature HUD painted in that theme's colours -->
        <DataTemplate x:Key="PaletteSwatch">
            <RadioButton Style="{StaticResource LayoutChoice}" Padding="6" GroupName="Palette" IsChecked="{Binding IsSelected}" Margin="0,0,8,8"
                         ToolTip="{Binding Tagline}">
                <StackPanel>
                    <Border Height="78" CornerRadius="6" Background="{Binding SurfaceBrush}" ClipToBounds="True">
                        <Grid>
                            <Border CornerRadius="6" Background="{Binding AmbientBrush}" />
                            <Grid Margin="8">
                                <Border Width="46" Height="36" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="5"
                                        Background="{Binding CardBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Margin="6">
                                        <Ellipse Width="9" Height="9" Fill="{Binding AccentBrush}" HorizontalAlignment="Left" />
                                        <Border Height="3" CornerRadius="1.5" Background="{Binding TextBrush}" Opacity="0.55" Margin="0,6,8,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="9:41" Foreground="{Binding TextBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Border Width="46" Height="36" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="5"
                                        Background="{Binding CardBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                                    <Grid Margin="6">
                                        <Border Height="3" CornerRadius="1.5" Background="{Binding TextBrush}" Opacity="0.25" VerticalAlignment="Bottom" />
                                        <Border Width="20" Height="3" CornerRadius="1.5" Background="{Binding AccentBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="2,8,0,0" />
                    <TextBlock Text="{Binding Tagline}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="2,1,0,2" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="SwatchPanel">
            <UniformGrid Columns="3" />
        </ItemsPanelTemplate>

        <LinearGradientBrush x:Key="Wallpaper" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF3F7BEA" Offset="0" />
            <GradientStop Color="#FF8A5CF6" Offset="0.6" />
            <GradientStop Color="#FFE0679E" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MockBar" Color="#C8141418" />
        <SolidColorBrush x:Key="MockTile" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="MockWindow" Color="#EEF7F7FA" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="780">

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/LifeHUD.ico" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Life HUD" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Less switching. More living." Style="{StaticResource SettingDesc}" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <!-- Layout -->
            <TextBlock Text="Layout" Style="{StaticResource SectionHeader}" />
            <UniformGrid Columns="2" Margin="0,0,0,4">
                <RadioButton Style="{StaticResource LayoutChoice}" GroupName="Layout" IsChecked="{Binding IsTopLayout}" Margin="0,0,4,0">
                    <StackPanel>
                        <Border Height="104" CornerRadius="6" Background="{StaticResource Wallpaper}" ClipToBounds="True">
                            <Grid>
                                <Border VerticalAlignment="Top" Height="17" Background="{StaticResource MockBar}" CornerRadius="6,6,0,0">
                                    <Grid Margin="6,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border Width="18" Height="7" CornerRadius="2" Background="{StaticResource MockTile}" Margin="0,0,3,0" />
                                            <Border Width="34" Height="7" CornerRadius="2" Background="{StaticResource MockTile}" />
                                        </StackPanel>
                                        <TextBlock Text="10:42" Foreground="White" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Width="30" Height="7" CornerRadius="2" Background="{StaticResource MockTile}" Margin="0,0,3,0" />
                                            <Border Width="22" Height="7" CornerRadius="2" Background="{StaticResource MockTile}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Margin="0,17,0,9" Background="{StaticResource MockWindow}" />
                                <Border VerticalAlignment="Bottom" Height="9" Background="{StaticResource MockBar}" CornerRadius="0,0,6,6" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Top HUD" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="A slim strip across the top for quick glances. Keeps the full width of your screen for work."
                                   Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource LayoutChoice}" GroupName="Layout" IsChecked="{Binding IsSideLayout}" Margin="4,0,0,0">
                    <StackPanel>
                        <Border Height="104" CornerRadius="6" Background="{StaticResource Wallpaper}" ClipToBounds="True">
                            <Grid>
                                <Border HorizontalAlignment="Left" Width="34" Margin="0,0,0,9" Background="{StaticResource MockBar}" CornerRadius="6,0,0,0">
                                    <StackPanel Margin="5,6,5,0">
                                        <TextBlock Text="10:42" Foreground="White" FontSize="7.5" FontWeight="SemiBold" />
                                        <Border Height="14" CornerRadius="2" Background="{StaticResource MockTile}" Margin="0,4,0,0" />
                                        <Border Height="10" CornerRadius="2" Background="{StaticResource MockTile}" Margin="0,3,0,0" />
                                        <Border Height="22" CornerRadius="2" Background="{StaticResource MockTile}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="34,0,0,9" Background="{StaticResource MockWindow}" CornerRadius="0,6,0,0" />
                                <Border VerticalAlignment="Bottom" Height="9" Background="{StaticResource MockBar}" CornerRadius="0,0,6,6" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Life Sidebar" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="A focused column on the left with room for your full task list, forecast and notes."
                                   Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Size" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding SizeCaption}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Width="240" VerticalAlignment="Center"
                            Minimum="{Binding SizeMin}" Maximum="{Binding SizeMax}" Value="{Binding SizePercent}"
                            TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Display" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Which monitor the HUD reserves space on." Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="240" VerticalAlignment="Center"
                              ItemsSource="{Binding Monitors}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedMonitor}" />
                </Grid>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="Theme" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="SIGNATURE" Style="{StaticResource GalleryHeader}" />
            <ItemsControl ItemsSource="{Binding SignaturePalettes}" ItemTemplate="{StaticResource PaletteSwatch}"
                          ItemsPanel="{StaticResource SwatchPanel}" Margin="0,0,-8,0" Focusable="False" />
            <TextBlock Text="MOODS" Style="{StaticResource GalleryHeader}" Margin="2,10,0,8" />
            <ItemsControl ItemsSource="{Binding MoodPalettes}" ItemTemplate="{StaticResource PaletteSwatch}"
                          ItemsPanel="{StaticResource SwatchPanel}" Margin="0,0,-8,0" Focusable="False" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Light or dark" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Applies to the Classic theme. Other themes have their own tone." Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center" IsEnabled="{Binding IsModeEditable}"
                              ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedTheme}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clock" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Time format for the clock and hourly forecast." Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="24-hour" IsChecked="{Binding Use24HourClock}" Margin="0,0,20,0" />
                        <CheckBox Content="Seconds" IsChecked="{Binding ShowSeconds}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Weather -->
            <TextBlock Text="Weather" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Location" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Leave empty to use Windows location. Press Enter to apply." Style="{StaticResource SettingDesc}" />
                        <TextBlock Text="{Binding WeatherStatus}" Style="{StaticResource SettingDesc}" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <TextBox x:Name="CityBox" Grid.Column="1" Width="240" VerticalAlignment="Center"
                             Text="{Binding City, UpdateSourceTrigger=LostFocus}" KeyDown="OnCityKeyDown" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Units" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                              ItemsSource="{Binding UnitOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding UseCelsius}" />
                </Grid>
            </Border>

            <!-- Music -->
            <TextBlock Text="Music" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Prefer Spotify" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Show Spotify even when another app (like a browser tab) is also playing. Works with the Spotify desktop app; no sign-in needed."
                                   Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding PreferSpotify}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="Open Life HUD automatically when you sign in." Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Your data" Style="{StaticResource SettingTitle}" />
                        <TextBlock Text="{Binding DataFolder, StringFormat='Notes, tasks and settings are stored only on this PC, in {0}'}" Style="{StaticResource SettingDesc}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="{Binding HudToggleText}" Command="{Binding ToggleHudCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding VersionText}" Style="{StaticResource SettingDesc}" Margin="2,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
