<c:WidgetView x:Class="LifeHUD.Widgets.WeatherWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:LifeHUD.Controls"
              x:Name="Self">
    <Grid>
        <!-- ===================== Top HUD ===================== -->
        <Border Style="{StaticResource Card}" Padding="14,6"
                Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource InvBoolToVis}}"
                ToolTip="{Binding DetailsText}">
            <Grid>
                <Grid VerticalAlignment="Center" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:WeatherIcon Width="42" Height="42" VerticalAlignment="Center"
                                   Condition="{Binding Condition}" IsDay="{Binding IsDay}" CloudBrush="{DynamicResource WeatherCloudBrush}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TemperatureText}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,-5,0,-3" />
                        <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" MaxWidth="120" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="130">
                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyStrong}" />
                        <TextBlock Text="{Binding HighLowText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                    <Border Grid.Column="3" Margin="14,4,0,4" Padding="10,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerBrush}"
                            Visibility="{Binding IsCompact, ElementName=Self, Converter={StaticResource InvBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding UpcomingDays}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="38" Margin="1,0">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" />
                                        <c:WeatherIcon Width="20" Height="20" Margin="0,2" Condition="{Binding Condition}" CloudBrush="{DynamicResource WeatherCloudBrush}" />
                                        <TextBlock Text="{Binding HighText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>

                <Grid VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                      Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}">
                    <Grid.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenSettingsCommand}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <c:WeatherIcon Width="34" Height="34" Opacity="0.55" Condition="PartlyCloudy" CloudBrush="{DynamicResource WeatherCloudBrush}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Weather" Style="{StaticResource BodyStrong}" />
                        <TextBlock Text="{Binding PlaceholderText}" Style="{StaticResource Caption}" MaxWidth="170" TextWrapping="Wrap" MaxHeight="34" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Life Sidebar ===================== -->
        <Border Style="{StaticResource Card}" Padding="14,12,14,10"
                Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Location}" Style="{StaticResource BodyStrong}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,2,0,0" ToolTip="{Binding DetailsText}">
                        <StackPanel>
                            <TextBlock Text="{Binding TemperatureText}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="-1,-4,0,-4" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" />
                            <TextBlock Text="{Binding HighLowText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <c:WeatherIcon Width="58" Height="58" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
                                       Condition="{Binding Condition}" IsDay="{Binding IsDay}" CloudBrush="{DynamicResource WeatherCloudBrush}" />
                    </Grid>

                    <!-- Hourly strip (dropped on short screens) -->
                    <ItemsControl ItemsSource="{Binding Hours}" Margin="-4,12,-4,0"
                                  Visibility="{Binding IsCompact, ElementName=Self, Converter={StaticResource InvBoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center" />
                                    <c:WeatherIcon Width="22" Height="22" Margin="0,3" Condition="{Binding Condition}" IsDay="{Binding IsDay}"
                                                   CloudBrush="{DynamicResource WeatherCloudBrush}" />
                                    <TextBlock Text="{Binding TemperatureText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,4" />

                    <!-- Daily forecast with temperature range bars -->
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <c:WeatherIcon Grid.Column="1" Width="18" Height="18" Condition="{Binding Condition}" CloudBrush="{DynamicResource WeatherCloudBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LowText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <c:RangeBar Grid.Column="3" Height="8" Margin="8,0" VerticalAlignment="Center"
                                                RangeMin="{Binding RangeMin}" RangeMax="{Binding RangeMax}" Low="{Binding Low}" High="{Binding High}"
                                                Marker="{Binding Marker}" Celsius="{Binding Celsius}" TrackBrush="{DynamicResource TrackBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding HighText}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Cursor="Hand" Background="Transparent" Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel.InputBindings>
                    <TextBlock Text="Weather" Style="{StaticResource WidgetTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:WeatherIcon Width="40" Height="40" Opacity="0.55" Condition="PartlyCloudy" CloudBrush="{DynamicResource WeatherCloudBrush}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding PlaceholderText}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</c:WidgetView>
