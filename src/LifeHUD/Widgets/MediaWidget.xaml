<c:WidgetView x:Class="LifeHUD.Widgets.MediaWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:LifeHUD.Controls"
              x:Name="Self">
    <c:WidgetView.Resources>
        <!-- Album art tile with a graceful placeholder -->
        <DataTemplate x:Key="ArtTile">
            <Border CornerRadius="8" Background="{DynamicResource ControlFillBrush}">
                <Grid>
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasArtwork, Converter={StaticResource InvBoolToVis}}" />
                    <Border CornerRadius="8" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SourceLabel">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource SpotifyBrush}" Margin="0,0,5,0" VerticalAlignment="Center"
                         Visibility="{Binding IsSpotify, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding SourceName}" Style="{StaticResource Overline}" />
            </StackPanel>
        </DataTemplate>
    </c:WidgetView.Resources>

    <Grid>
        <!-- ===================== Top HUD ===================== -->
        <Border Style="{StaticResource Card}" Padding="8" Width="384"
                Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource InvBoolToVis}}">
            <Grid>
                <Border CornerRadius="11" Margin="-8" Background="{Binding GlowBrush}" IsHitTestVisible="False" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Width="60" Height="60" VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource ArtTile}" />
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SourceLabel}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" Margin="0,2,0,0" ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource Caption}" />
                        <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,7,0,0" Value="{Binding Progress, Mode=OneWay}"
                                     ToolTip="{Binding ProgressTip}"
                                     Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" ToolTip="Previous" />
                        <Button Style="{StaticResource PlayButton}" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}" Margin="4,0" ToolTip="Play / Pause" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" ToolTip="Next" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="Open Spotify" Command="{Binding OpenSpotifyCommand}" VerticalAlignment="Center"
                            Visibility="{Binding HasMedia, Converter={StaticResource InvBoolToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Life Sidebar ===================== -->
        <Border Style="{StaticResource Card}" Padding="12"
                Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Border CornerRadius="11" Margin="-12" Background="{Binding GlowBrush}" IsHitTestVisible="False" />
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Width="68" Height="68" VerticalAlignment="Top" Content="{Binding}" ContentTemplate="{StaticResource ArtTile}" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SourceLabel}" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="14" Margin="0,3,0,0"
                                       TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Progress, Mode=OneWay}" />
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Caption}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Width="36" Height="36" FontSize="15"
                                Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" ToolTip="Previous" />
                        <Button Style="{StaticResource PlayButton}" Content="{Binding PlayPauseGlyph}" Width="44" Height="44" FontSize="16" Margin="14,0"
                                Command="{Binding PlayPauseCommand}" ToolTip="Play / Pause" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Width="36" Height="36" FontSize="15"
                                Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" ToolTip="Next" />
                    </StackPanel>
                    <Button Style="{StaticResource PillButton}" Content="Open Spotify" Command="{Binding OpenSpotifyCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Visibility="{Binding HasMedia, Converter={StaticResource InvBoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</c:WidgetView>
