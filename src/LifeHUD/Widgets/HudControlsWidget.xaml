<c:WidgetView x:Class="LifeHUD.Widgets.HudControlsWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:LifeHUD.Controls"
              x:Name="Self">
    <Grid>
        <!-- Top HUD: a slim column of system controls at the trailing edge -->
        <StackPanel VerticalAlignment="Center" Margin="2,0,0,0"
                    Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource InvBoolToVis}}">
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE713;"
                    Command="{Binding OpenSettingsCommand}" ToolTip="Settings" />
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE90C;"
                    Command="{Binding ToggleLayoutCommand}" ToolTip="{Binding LayoutToggleTip}" />
            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE921;"
                    Command="{Binding HideCommand}" ToolTip="Hide (restore from the tray icon)" />
        </StackPanel>

        <!-- Life Sidebar: a quiet footer -->
        <Grid Margin="10,0,2,0" Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Life HUD" Style="{StaticResource Overline}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="12"
                        Command="{Binding HideCommand}" ToolTip="Hide (restore from the tray icon)" />
                <Button Style="{StaticResource IconButton}" FontSize="12" Command="{Binding ToggleLayoutCommand}" ToolTip="{Binding LayoutToggleTip}">
                    <TextBlock Text="&#xE90C;" FontFamily="{StaticResource IconFont}">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="12"
                        Command="{Binding OpenSettingsCommand}" ToolTip="Settings" />
            </StackPanel>
        </Grid>
    </Grid>
</c:WidgetView>
