<c:WidgetView x:Class="LifeHUD.Widgets.TasksWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:c="clr-namespace:LifeHUD.Controls"
              x:Name="Self">
    <c:WidgetView.Resources>
        <DataTemplate x:Key="TaskRow">
            <Grid x:Name="Row" Background="Transparent" Height="25" RenderTransformOrigin="0.5,0.5" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Slide" Y="5" />
                </Grid.RenderTransform>
                <CheckBox Style="{StaticResource TaskCheck}" IsChecked="{Binding IsDone}" Margin="0,0,24,0">
                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{Binding Title}" ToolTipService.InitialShowDelay="900" />
                </CheckBox>
                <Button x:Name="Delete" Style="{StaticResource IconButton}" Content="&#xE711;" Width="22" Height="22" FontSize="9"
                        HorizontalAlignment="Right" Visibility="Hidden" ToolTip="Remove"
                        Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Delete" Property="Visibility" Value="Visible" />
                </Trigger>
                <EventTrigger SourceName="Row" RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Row" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AddBox">
            <Border Background="{DynamicResource InputBrush}" CornerRadius="7" Padding="9,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource GhostTextBox}" Tag="Add a task" Margin="7,0,0,0" MaxLength="200"
                             Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnAddBoxKeyDown">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddTaskCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Border>
        </DataTemplate>
    </c:WidgetView.Resources>

    <Grid>
        <!-- ===================== Top HUD ===================== -->
        <Border Style="{StaticResource Card}" Padding="12,7"
                Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource InvBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="46" Height="46" VerticalAlignment="Center" ToolTip="{Binding SummaryText}">
                    <c:ProgressRing Value="{Binding Progress}" Thickness="4" TrackBrush="{DynamicResource TrackBrush}" FillBrush="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding RatioText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </Grid>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TaskRow}" Focusable="False" />
                    </ScrollViewer>
                    <TextBlock Text="Nothing planned. What matters today?" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ContentPresenter Grid.Row="1" Margin="0,3,0,0" Content="{Binding}" ContentTemplate="{StaticResource AddBox}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Life Sidebar ===================== -->
        <Border Style="{StaticResource Card}" Padding="14,12,14,12"
                Visibility="{Binding IsVertical, ElementName=Self, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Today" Style="{StaticResource WidgetTitle}" />
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="12" VerticalAlignment="Top"
                            ToolTip="Clear completed" Command="{Binding ClearCompletedCommand}"
                            Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgress}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,6"
                             Value="{Binding Progress, Mode=OneWay}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TaskRow}" Focusable="False" />
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="Nothing planned yet.&#x0a;Add the first thing you want to get done." Style="{StaticResource Caption}"
                           TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Top" Margin="0,6,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ContentPresenter Grid.Row="3" Margin="0,6,0,0" Content="{Binding}" ContentTemplate="{StaticResource AddBox}" />
            </Grid>
        </Border>
    </Grid>
</c:WidgetView>
