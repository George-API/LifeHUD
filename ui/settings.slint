import { Switch, Slider, AboutSlint, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { StickerPattern } from "stickers.slint";
import { Look, Group, Row, OrderButton, Footnote, Segmented, PageTitle, PushButton, PopupSelect, TextField } from "settings-kit.slint";
import { WidgetLayout, SportsPage, YouTubePage, RedditPage, NetflixPage, StocksPage } from "feeds/settings.slint";

export struct ThemeSwatch {
    id: string,
    name: string,
    surface: color,
    ambient-a: color,
    ambient-b: color,
    ambient-c: color,
    card: color,
    text: color,
    accent: color,
    selected: bool,
    sticker: int,
}

export struct PlaylistRow {
    name: string,
    uri: string,
    pinned: bool,
}

export struct AiProviderRow {
    /// Which provider this row is (passed back in callbacks).
    index: int,
    name: string,
    vendor: string,
    has-key: bool,
    model: string,
    default-model: string,
}

/// One widget on the Widgets overview page.
export struct WidgetTile {
    id: string,
    name: string,
    detail: string,
    /// Its settings page, or -1 when it has none.
    page: int,
    /// "On HUD" or "Not shown" (both layouts show the same widgets).
    placement: string,
    shown: bool,
}

export global SettingsState {
    in-out property <int> page;

    // Widgets overview (page 30) and the sidebar's Widgets group.
    in property <[WidgetTile]> widget-tiles;
    in-out property <bool> widgets-open: true;

    in-out property <bool> hud-visible: true;
    in-out property <bool> open-at-login;

    in-out property <bool> top-layout: true;
    in-out property <bool> fit-windows: true;
    in-out property <float> size-percent: 9;
    in property <float> size-min: 7;
    in property <float> size-max: 18;
    in property <[string]> monitors: ["Display 1"];
    in-out property <int> monitor-index;

    in property <[ThemeSwatch]> themes;
    in-out property <int> appearance;
    in property <bool> appearance-enabled: true;
    in-out property <bool> use-24h;
    in-out property <bool> show-seconds;

    in-out property <string> city;
    in property <string> weather-status;
    in-out property <int> units;

    in-out property <bool> prefer-spotify: true;
    in property <[PlaylistRow]> playlists;
    in-out property <string> playlist-link;
    in property <string> playlist-error;
    callback add-playlist(string);
    callback toggle-pin(string);
    callback remove-playlist(string);

    /// Restore the default widgets, their order and the HUD size.
    callback reset-layout();

    in property <[string]> curated-sources;
    in-out property <int> curated-index;
    in property <[string]> top-sources;
    in-out property <int> top-index;

    in property <string> version: "0.1.0";

    /// Something changed; Rust re-reads the named group of properties.
    callback changed(string);
    callback select-theme(string);
    callback open-data-folder();
    /// Opens one of the project's web pages (Rust allows only the project's own GitHub URLs).
    callback open-link(string);

    // AI chat (page 20)
    in property <[AiProviderRow]> ai-providers;
    in-out property <bool> ai-button: true;
    /// A message per provider, by provider index (e.g. a rejected key or model name).
    in property <[string]> ai-errors: ["", "", ""];
    callback ai-save-key(int, string);
    callback ai-remove-key(int);
    callback ai-set-model(int, string);
    callback ai-get-key(int);
}

component SidebarItem {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    /// Nested items (a group's children) sit further in.
    in property <length> indent: 0;
    /// A group header shows a disclosure arrow; `expanded` picks its direction.
    in property <bool> disclosure;
    in property <bool> expanded;
    callback clicked;
    callback toggled;

    height: 30px;

    Rectangle {
        border-radius: 6px;
        background: root.selected ? Look.selection : ta.has-hover ? Look.hover : transparent;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px + root.indent;
        padding-right: 4px;
        spacing: 9px;
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.selected ? Theme.accent : WidgetLook.tile;
            animate background { duration: 120ms; }
            Image { source: root.icon; width: 13px; height: 13px; colorize: root.selected ? Theme.on-accent : WidgetLook.glyph; }
        }
        Text {
            text: root.label;
            font-size: 13px;
            color: Look.label;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Its own hit area: the arrow folds the group, the rest of the row opens its page.
        if root.disclosure : Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: arrow.has-hover ? Look.hover : transparent;
            Image {
                source: root.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
                width: 11px;
                height: 11px;
                colorize: Look.secondary;
            }
            arrow := TouchArea { clicked => { root.toggled(); } }
        }
    }
}

/// Settings page icon for each widget, and the shared icon-tile colours, used by the sidebar and the
/// Widgets overview.
global WidgetLook {
    pure public function icon(id: string) -> image {
        return id == "weather" ? @image-url("icons/cloud.svg")
            : id == "music" ? @image-url("icons/music.svg")
            : id == "today" ? @image-url("icons/check.svg")
            : id == "news" ? @image-url("icons/newspaper.svg")
            : id == "sports" ? @image-url("icons/sports.svg")
            : id == "youtube" ? @image-url("icons/youtube.svg")
            : id == "reddit" ? @image-url("icons/reddit.svg")
            : id == "netflix" ? @image-url("icons/netflix.svg")
            : id == "stocks" ? @image-url("icons/stocks.svg")
            : @image-url("icons/sparkle.svg");
    }
    /// Icon tiles are one neutral grey, so the sidebar stays calm; the accent marks the current page.
    out property <color> tile: Theme.dark ? #ffffff1a : #0000000f;
    out property <color> glyph: Theme.dark ? #ffffffcc : #3c3c43d9;
}

/// A widget on the Widgets overview: what it is, where it's placed, and a way into its settings.
component WidgetCard {
    in property <WidgetTile> tile;
    callback clicked;

    property <bool> link: root.tile.page >= 0;

    Rectangle {
        background: ta.has-hover && root.link ? Look.hover : Look.group;
        border-radius: 10px;
        border-width: 1px;
        border-color: Look.group-border;
    }
    ta := TouchArea {
        enabled: root.link;
        mouse-cursor: root.link ? pointer : default;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: WidgetLook.tile;
                Image { source: WidgetLook.icon(root.tile.id); width: 16px; height: 16px; colorize: WidgetLook.glyph; }
            }
            Text {
                text: root.tile.name;
                font-size: 13px;
                font-weight: 600;
                color: Look.label;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.link : Image {
                source: @image-url("icons/chevron-right.svg");
                width: 10px;
                height: 10px;
                y: (parent.height - self.height) / 2;
                colorize: Look.secondary;
            }
        }
        Text {
            text: root.tile.detail;
            font-size: 11px;
            color: Look.secondary;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 18px;
                border-radius: 9px;
                background: root.tile.shown ? Theme.accent.with-alpha(0.16) : Look.hover;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.tile.placement;
                        font-size: 11px;
                        font-weight: 600;
                        color: root.tile.shown ? Theme.accent : Look.secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component LayoutTile {
    in property <string> label;
    in property <bool> top;
    in property <bool> selected;
    callback clicked;

    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 96px;
            border-radius: 9px;
            border-width: root.selected ? 3px : 1px;
            border-color: root.selected ? Theme.accent : Look.group-border;
            background: @linear-gradient(135deg, #3f7bea 0%, #8a5cf6 60%, #e0679e 100%);
            clip: true;
            // Docked bar
            Rectangle {
                x: root.top ? 0 : 0;
                y: 0;
                width: root.top ? parent.width : 30px;
                height: root.top ? 14px : parent.height;
                background: #141418c8;
            }
            // A maximized window filling the rest
            Rectangle {
                x: root.top ? 0 : 30px;
                y: root.top ? 14px : 0;
                width: root.top ? parent.width : parent.width - 30px;
                height: root.top ? parent.height - 14px : parent.height;
                background: #f7f7fae6;
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 600 : 400;
            color: Look.label;
            horizontal-alignment: center;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component Swatch {
    in property <ThemeSwatch> swatch;
    callback clicked;

    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 58px;
            border-radius: 10px;
            border-width: root.swatch.selected ? 3px : 0px;
            border-color: Theme.accent;
            Rectangle {
                x: root.swatch.selected ? 4px : 0;
                y: root.swatch.selected ? 4px : 0;
                width: parent.width - (root.swatch.selected ? 8px : 0);
                height: parent.height - (root.swatch.selected ? 8px : 0);
                border-radius: root.swatch.selected ? 7px : 10px;
                background: root.swatch.surface;
                clip: true;
                Rectangle { background: @linear-gradient(135deg, root.swatch.ambient-a 0%, root.swatch.ambient-b 50%, root.swatch.ambient-c 100%); }
                // Centred: shows the composed motif cluster at the middle of each theme's tile.
                if root.swatch.sticker > 0 : StickerPattern { width: parent.width; height: parent.height; set: root.swatch.sticker; ink: root.swatch.text; strength: 0.22; horizontal-alignment: center; vertical-alignment: center; }
                Text {
                    y: 6px;
                    text: "9:41";
                    font-size: 15px;
                    font-weight: 700;
                    color: root.swatch.text;
                }
                Rectangle {
                    x: 8px;
                    y: parent.height - self.height - 7px;
                    width: parent.width - 16px;
                    height: 14px;
                    border-radius: 4px;
                    background: root.swatch.card;
                    Rectangle {
                        x: 4px;
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.swatch.accent;
                    }
                }
            }
        }
        Text {
            text: root.swatch.name;
            font-size: 12px;
            color: Look.label;
            horizontal-alignment: center;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component SettingsWindow inherits Window {
    title: "Life HUD";
    icon: @image-url("../assets/icon.png");
    preferred-width: 780px;
    preferred-height: 560px;
    min-width: 680px;
    min-height: 540px;
    background: Look.window;
    default-font-family: Look.font;

    property <bool> dark: Theme.dark;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    // Arriving on a widget's page from elsewhere (the weather card, the music menu) unfolds the
    // Widgets group so the selected item is visible.
    property <int> page: SettingsState.page;
    changed page => {
        if (page >= 3 && page <= 5) || (page >= 7 && page <= 11) {
            SettingsState.widgets-open = true;
        }
    }

    HorizontalLayout {
        // ------------------------------------------------ Sidebar
        Rectangle {
            width: 210px;
            background: Look.sidebar;
            VerticalLayout {
                padding: 12px;
                padding-top: 18px;
                spacing: 2px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    Image { source: @image-url("../assets/icon.png"); width: 28px; height: 28px; }
                    Text { text: "Life HUD"; font-size: 15px; font-weight: 600; color: Look.label; vertical-alignment: center; }
                }
                SidebarItem { label: "General"; icon: @image-url("icons/gear.svg"); selected: SettingsState.page == 0; clicked => { SettingsState.page = 0; } }
                SidebarItem { label: "Layout"; icon: @image-url("icons/sidebar-left.svg"); selected: SettingsState.page == 1; clicked => { SettingsState.page = 1; } }
                SidebarItem { label: "Appearance"; icon: @image-url("icons/paintbrush.svg"); selected: SettingsState.page == 2; clicked => { SettingsState.page = 2; } }
                // Widgets: the overview, with each widget's settings nested beneath it.
                SidebarItem {
                    label: "Widgets";
                    icon: @image-url("icons/widgets.svg");
                    selected: SettingsState.page == 30;
                    disclosure: true;
                    expanded: SettingsState.widgets-open;
                    clicked => { SettingsState.page = 30; SettingsState.widgets-open = true; }
                    toggled => { SettingsState.widgets-open = !SettingsState.widgets-open; }
                }
                if SettingsState.widgets-open : VerticalLayout {
                    spacing: 2px;
                    SidebarItem { indent: 14px; label: "Weather"; icon: WidgetLook.icon("weather"); selected: SettingsState.page == 3; clicked => { SettingsState.page = 3; } }
                    SidebarItem { indent: 14px; label: "Music"; icon: WidgetLook.icon("music"); selected: SettingsState.page == 4; clicked => { SettingsState.page = 4; } }
                    SidebarItem { indent: 14px; label: "News"; icon: WidgetLook.icon("news"); selected: SettingsState.page == 5; clicked => { SettingsState.page = 5; } }
                    SidebarItem { indent: 14px; label: "Sports"; icon: WidgetLook.icon("sports"); selected: SettingsState.page == 7; clicked => { SettingsState.page = 7; } }
                    SidebarItem { indent: 14px; label: "YouTube"; icon: WidgetLook.icon("youtube"); selected: SettingsState.page == 8; clicked => { SettingsState.page = 8; } }
                    SidebarItem { indent: 14px; label: "Reddit"; icon: WidgetLook.icon("reddit"); selected: SettingsState.page == 9; clicked => { SettingsState.page = 9; } }
                    SidebarItem { indent: 14px; label: "Netflix"; icon: WidgetLook.icon("netflix"); selected: SettingsState.page == 10; clicked => { SettingsState.page = 10; } }
                    SidebarItem { indent: 14px; label: "Stocks"; icon: WidgetLook.icon("stocks"); selected: SettingsState.page == 11; clicked => { SettingsState.page = 11; } }
                }
                Rectangle { height: 6px; }
                SidebarItem { label: "Search & AI"; icon: @image-url("icons/search.svg"); selected: SettingsState.page == 20; clicked => { SettingsState.page = 20; } }
                SidebarItem { label: "About"; icon: @image-url("icons/info.svg"); selected: SettingsState.page == 6; clicked => { SettingsState.page = 6; } }
            }
        }

        // ------------------------------------------------ Content
        ScrollView {
            VerticalLayout {
                padding: 28px;
                padding-top: 22px;
                spacing: 12px;
                alignment: start;

                // General
                if SettingsState.page == 0 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "General"; }
                    Group {
                        Row {
                            label: "Show Life HUD";
                            detail: "You can also show or hide it from the tray icon.";
                            Switch { checked <=> SettingsState.hud-visible; toggled => { SettingsState.changed("visibility"); } }
                        }
                        Row {
                            label: "Open at login";
                            detail: "Start Life HUD when you sign in to Windows.";
                            last: true;
                            Switch { checked <=> SettingsState.open-at-login; toggled => { SettingsState.changed("startup"); } }
                        }
                    }
                    Group {
                        Row {
                            label: "Your data";
                            detail: "Notes, tasks and settings stay on this PC.";
                            last: true;
                            PushButton { text: "Show in Explorer"; clicked => { SettingsState.open-data-folder(); } }
                        }
                    }
                }

                // Layout
                if SettingsState.page == 1 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "Layout"; }
                    HorizontalLayout {
                        spacing: 16px;
                        LayoutTile {
                            label: "Top HUD";
                            top: true;
                            selected: SettingsState.top-layout;
                            clicked => { SettingsState.top-layout = true; SettingsState.changed("layout"); }
                        }
                        LayoutTile {
                            label: "Sidebar";
                            top: false;
                            selected: !SettingsState.top-layout;
                            clicked => { SettingsState.top-layout = false; SettingsState.changed("layout"); }
                        }
                    }
                    Rectangle { height: 4px; }
                    Group {
                        Row {
                            label: "Size";
                            detail: SettingsState.top-layout ? "How much of the screen's height the bar uses." : "How much of the screen's width the Sidebar uses.";
                            Slider {
                                width: 200px;
                                minimum: SettingsState.size-min;
                                maximum: SettingsState.size-max;
                                step: 0.5;
                                value <=> SettingsState.size-percent;
                                changed => { SettingsState.changed("size"); }
                            }
                            Text {
                                width: 40px;
                                // What gets saved: the nearest half percent.
                                text: round(SettingsState.size-percent * 2) / 2 + "%";
                                font-size: 12px;
                                color: Look.secondary;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        Row {
                            label: "Fit open windows";
                            detail: "Resize other windows to the space that's left.";
                            Switch { checked <=> SettingsState.fit-windows; toggled => { SettingsState.changed("fit"); } }
                        }
                        Row {
                            label: "Display";
                            last: true;
                            PopupSelect {
                                width: 220px;
                                model: SettingsState.monitors;
                                current-index <=> SettingsState.monitor-index;
                                selected => { SettingsState.changed("monitor"); }
                            }
                        }
                    }
                    Group {
                        Row {
                            label: "Widgets";
                            detail: "Choose what the Top HUD and Sidebar show.";
                            PushButton {
                                text: "Choose Widgets…";
                                clicked => { SettingsState.page = 30; SettingsState.widgets-open = true; }
                            }
                        }
                        Row {
                            label: "Reset layout";
                            detail: "Restore the default widgets, their order and the HUD size.";
                            last: true;
                            // Two clicks, so a stray one can't undo a carefully arranged layout.
                            reset := PushButton {
                                destructive: true;
                                property <bool> armed;
                                text: self.armed ? "Click again to reset" : "Reset to Default";
                                clicked => {
                                    if self.armed {
                                        self.armed = false;
                                        SettingsState.reset-layout();
                                    } else {
                                        self.armed = true;
                                    }
                                }
                            }
                            Timer {
                                interval: 4s;
                                running: reset.armed;
                                triggered => { reset.armed = false; }
                            }
                        }
                    }
                }

                // Appearance
                if SettingsState.page == 2 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "Appearance"; }
                    Text { text: "Theme"; font-size: 13px; font-weight: 600; color: Look.label; }
                    Rectangle {
                        property <int> columns: 4;
                        property <length> cell-gap: 12px;
                        property <length> cell-width: (self.width - (self.columns - 1) * self.cell-gap) / self.columns;
                        property <length> cell-height: 86px;
                        height: ceil(SettingsState.themes.length / self.columns) * (self.cell-height + self.cell-gap);
                        for swatch[i] in SettingsState.themes : Swatch {
                            x: mod(i, parent.columns) * (parent.cell-width + parent.cell-gap);
                            y: floor(i / parent.columns) * (parent.cell-height + parent.cell-gap);
                            width: parent.cell-width;
                            height: parent.cell-height;
                            swatch: swatch;
                            clicked => { SettingsState.select-theme(swatch.id); }
                        }
                    }
                    Group {
                        Row {
                            label: "Light or dark";
                            detail: SettingsState.appearance-enabled ? "Auto follows Windows." : "This theme has one look in every mode. Signature themes switch between light and dark.";
                            last: true;
                            Segmented {
                                width: 220px;
                                items: ["Auto", "Light", "Dark"];
                                enabled: SettingsState.appearance-enabled;
                                index <=> SettingsState.appearance;
                                changed => { SettingsState.changed("theme"); }
                            }
                        }
                    }
                    Text { text: "Clock"; font-size: 13px; font-weight: 600; color: Look.label; }
                    Group {
                        Row {
                            label: "24-hour time";
                            Switch { checked <=> SettingsState.use-24h; toggled => { SettingsState.changed("clock"); } }
                        }
                        Row {
                            label: "Show seconds";
                            last: true;
                            Switch { checked <=> SettingsState.show-seconds; toggled => { SettingsState.changed("clock"); } }
                        }
                    }
                }

                // Weather
                if SettingsState.page == 3 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "Weather"; }
                    Group {
                        Row {
                            label: "Location";
                            detail: "Leave blank to use this PC's location. Type a city and press Enter.";
                            TextField {
                                width: 220px;
                                placeholder-text: "This PC's location";
                                text <=> SettingsState.city;
                                accepted => { SettingsState.changed("weather"); }
                            }
                        }
                        Row {
                            label: "Units";
                            last: true;
                            Segmented {
                                width: 140px;
                                items: ["°C", "°F"];
                                index <=> SettingsState.units;
                                changed => { SettingsState.changed("weather"); }
                            }
                        }
                    }
                    if SettingsState.weather-status != "" : Footnote { text: SettingsState.weather-status; }
                }

                // Music
                if SettingsState.page == 4 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "Music"; }
                    Group {
                        Row {
                            label: "Prefer Spotify";
                            detail: "When more than one app is playing.";
                            last: true;
                            Switch { checked <=> SettingsState.prefer-spotify; toggled => { SettingsState.changed("media"); } }
                        }
                    }
                    Footnote { text: "Works with the Spotify desktop app. No sign-in needed."; }
                    Text { text: "Playlists"; font-size: 13px; font-weight: 600; color: Look.label; }
                    Group {
                        for p in SettingsState.playlists : Row {
                            label: p.name;
                            OrderButton {
                                icon: p.pinned ? @image-url("icons/pin-fill.svg") : @image-url("icons/pin.svg");
                                active: p.pinned;
                                clicked => { SettingsState.toggle-pin(p.uri); }
                            }
                            OrderButton {
                                icon: @image-url("icons/trash.svg");
                                clicked => { SettingsState.remove-playlist(p.uri); }
                            }
                        }
                        Row {
                            label: SettingsState.playlists.length == 0 ? "Add a playlist" : "Add another";
                            last: true;
                            TextField {
                                width: 240px;
                                placeholder-text: "Paste a Spotify link";
                                text <=> SettingsState.playlist-link;
                                accepted => { SettingsState.add-playlist(self.text); }
                            }
                            PushButton { text: "Add"; clicked => { SettingsState.add-playlist(SettingsState.playlist-link); } }
                        }
                    }
                    Footnote {
                        text: SettingsState.playlist-error != "" ? SettingsState.playlist-error
                            : "Right-click the music widget to open these in Spotify. Pinned ones sit at the top. In Spotify, use Share → Copy link to get a playlist, album, artist or podcast link.";
                    }
                }

                // News
                if SettingsState.page == 5 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "News"; }
                    Group {
                        Row {
                            label: "Curated tab";
                            detail: "Technology and science.";
                            PopupSelect {
                                width: 220px;
                                model: SettingsState.curated-sources;
                                current-index <=> SettingsState.curated-index;
                                selected => { SettingsState.changed("news"); }
                            }
                        }
                        Row {
                            label: "Top tab";
                            detail: "General headlines for your region.";
                            last: true;
                            PopupSelect {
                                width: 220px;
                                model: SettingsState.top-sources;
                                current-index <=> SettingsState.top-index;
                                selected => { SettingsState.changed("news"); }
                            }
                        }
                    }
                    Footnote { text: "Headlines come from each publisher's free public feed and open in your browser."; }
                }
                // AI chat
                // Widgets overview: every widget at a glance, then where each one goes.
                if SettingsState.page == 30 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "Widgets"; }
                    // Placement first: there's only so much room, so arranging is the main job here.
                    WidgetLayout { }
                    Rectangle { height: 6px; }
                    Text { text: "All widgets"; font-size: 13px; font-weight: 600; color: Look.label; }
                    Footnote { text: "Open a widget to set it up."; }
                    grid := Rectangle {
                        property <int> columns: self.width >= 520px ? 3 : 2;
                        property <length> gap: 10px;
                        property <length> card-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
                        property <length> card-height: 108px;
                        height: ceil(SettingsState.widget-tiles.length / self.columns) * (self.card-height + self.gap) - self.gap;
                        for tile[i] in SettingsState.widget-tiles : WidgetCard {
                            x: mod(i, grid.columns) * (grid.card-width + grid.gap);
                            y: floor(i / grid.columns) * (grid.card-height + grid.gap);
                            width: grid.card-width;
                            height: grid.card-height;
                            tile: tile;
                            clicked => { SettingsState.page = tile.page; }
                        }
                    }
                }

                if SettingsState.page == 7 : SportsPage { }
                if SettingsState.page == 8 : YouTubePage { }
                if SettingsState.page == 9 : RedditPage { }
                if SettingsState.page == 10 : NetflixPage { }
                if SettingsState.page == 11 : StocksPage { }
                if SettingsState.page == 20 : VerticalLayout {
                    spacing: 12px;
                    PageTitle { text: "Search & AI"; }
                    Group {
                        Row {
                            label: "Show search button";
                            detail: "Adds a magnifying glass to the HUD that opens Google search and the AI chat. Search needs no key.";
                            last: true;
                            Switch { checked <=> SettingsState.ai-button; toggled => { SettingsState.changed("ai"); } }
                        }
                    }
                    for p in SettingsState.ai-providers : VerticalLayout {
                        spacing: 8px;
                        Text { text: p.name; font-size: 13px; font-weight: 600; color: Look.label; }
                        Group {
                            if p.has-key : Row {
                                label: p.vendor + " API key";
                                detail: "Saved in Windows Credential Manager.";
                                PushButton { text: "Remove"; destructive: true; clicked => { SettingsState.ai-remove-key(p.index); } }
                            }
                            if !p.has-key : Row {
                                label: p.vendor + " API key";
                                key := TextField {
                                    width: 200px;
                                    input-type: password;
                                    placeholder-text: "Paste your key";
                                    accepted => { SettingsState.ai-save-key(p.index, self.text); }
                                }
                                PushButton { text: "Save"; primary: true; clicked => { SettingsState.ai-save-key(p.index, key.text); } }
                            }
                            Row {
                                label: "Model";
                                detail: "Default: " + p.default-model;
                                last: true;
                                TextField {
                                    width: 200px;
                                    text: p.model;
                                    placeholder-text: p.default-model;
                                    accepted => { SettingsState.ai-set-model(p.index, self.text); }
                                    edited => { SettingsState.ai-set-model(p.index, self.text); }
                                }
                                PushButton { text: "Get a key"; clicked => { SettingsState.ai-get-key(p.index); } }
                            }
                        }
                        if SettingsState.ai-errors[p.index] != "" : Footnote { text: SettingsState.ai-errors[p.index]; }
                    }
                    Footnote {
                        text: "Google search opens in your browser and needs no setup. The AI tabs are optional: bring your own API key from Anthropic, OpenAI or Google; usage is billed to that account. Your messages go straight from this PC to the provider you pick. Life HUD doesn't save conversations; they're cleared when it quits. Keys are kept in Windows Credential Manager, never in Life HUD's files.";
                    }
                }

                // About
                if SettingsState.page == 6 : VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    Rectangle { height: 16px; }
                    HorizontalLayout {
                        alignment: center;
                        Image { source: @image-url("../assets/icon.png"); width: 72px; height: 72px; }
                    }
                    Text { text: "Life HUD"; font-size: 20px; font-weight: 700; color: Look.label; horizontal-alignment: center; }
                    Text { text: "Version " + SettingsState.version; font-size: 12px; color: Look.secondary; horizontal-alignment: center; }
                    Text { text: "Open source under the MIT License."; font-size: 12px; color: Look.secondary; horizontal-alignment: center; }
                    Rectangle { height: 8px; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        PushButton { text: "View on GitHub"; clicked => { SettingsState.open-link("https://github.com/George-API/LifeHUD"); } }
                        PushButton { text: "Report a Problem"; clicked => { SettingsState.open-link("https://github.com/George-API/LifeHUD/issues/new/choose"); } }
                    }
                    Rectangle { height: 18px; }
                    HorizontalLayout {
                        alignment: center;
                        AboutSlint { max-width: 260px; }
                    }
                }
            }
        }
    }
}
