// Netflix: this week's global Top 10, shows and films, with big rank numerals and week-on-week
// movement. Clicking a title searches for it on Netflix.

import { Theme } from "../theme.slint";
import { Card } from "../components.slint";
import { NetflixState, TitleData } from "../feeds/state.slint";
import { FeedScroll, HScroll, PanelHeader, Placeholder, StripHeader, Tone } from "../feeds/common.slint";
import { HudState } from "../state.slint";
import { NowWatching } from "watching.slint";
import { PlayerBar, PlayerSlot } from "../feeds/common.slint";
import { PlayerState } from "../feeds/state.slint";

global Red {
    out property <color> red: #e50914;
}

component Movement inherits Rectangle {
    in property <TitleData> item;
    width: t.preferred-width + (root.item.trend == 2 ? 10px : 0px);
    height: 15px;
    border-radius: 4px;
    background: root.item.trend == 2 ? Red.red : transparent;
    t := Text {
        text: root.item.movement;
        font-size: root.item.trend == 2 ? 9px : 10.5px;
        font-weight: 700;
        letter-spacing: root.item.trend == 2 ? 0.5px : 0px;
        color: root.item.trend == 2 ? white : root.item.trend == 1 ? Tone.up : root.item.trend == -1 ? Tone.down : Theme.text3;
    }
}

component Rank inherits Text {
    in property <int> rank;
    text: root.rank;
    font-family: Theme.display-font;
    font-weight: 800;
    color: Theme.text.with-alpha(0.82);
    horizontal-alignment: right;
    vertical-alignment: center;
}

/// Top HUD tile: the rank large, then title and detail.
component TitleTile {
    in property <TitleData> item;
    accessible-role: button;
    accessible-label: "Number " + root.item.rank + ", " + root.item.title + ", " + root.item.detail
        + (root.item.trend == 2 ? ", new this week" : root.item.trend == 1 ? ", moving up" : root.item.trend == -1 ? ", moving down" : "");
    accessible-action-default => { NetflixState.open(root.item.url); }
    width: 214px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { NetflixState.open(root.item.url); }
    }
    Rectangle {
        border-radius: 9px;
        background: ta.has-hover ? Theme.fill-hover : Theme.fill;
        animate background { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 9px;
        Rank { rank: root.item.rank; width: 30px; font-size: min(30px, root.height * 0.72); }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.item.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                // Shortest Top HUD: no second line, so the movement sits beside the title.
                if root.height < 32px && root.item.movement != "" : Movement { item: root.item; y: (parent.height - self.height) / 2; }
            }
            if root.height >= 32px : HorizontalLayout {
                spacing: 6px;
                if root.item.movement != "" : Movement { item: root.item; y: (parent.height - self.height) / 2; }
                Text { text: root.item.detail; font-size: 11px; color: Theme.text3; overflow: elide; vertical-alignment: center; }
            }
        }
    }
}

/// Sidebar row: rank, title over detail, and the movement on the right.
component TitleRow {
    in property <TitleData> item;
    accessible-role: button;
    accessible-label: "Number " + root.item.rank + ", " + root.item.title + ", " + root.item.detail
        + (root.item.trend == 2 ? ", new this week" : root.item.trend == 1 ? ", moving up" : root.item.trend == -1 ? ", moving down" : "");
    accessible-action-default => { NetflixState.open(root.item.url); }
    height: 46px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { NetflixState.open(root.item.url); }
    }
    Rectangle {
        x: -6px;
        width: root.width + 12px;
        border-radius: 8px;
        background: ta.has-hover ? Theme.fill : transparent;
        animate background { duration: 120ms; }
    }
    HorizontalLayout {
        spacing: 12px;
        Rank { rank: root.item.rank; width: 30px; font-size: 26px; }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: root.item.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: root.item.detail; font-size: 11px; color: Theme.text3; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: end;
                if root.item.movement != "" : Movement { item: root.item; }
            }
            Text { text: root.item.views; font-size: 11px; color: Theme.text3; horizontal-alignment: right; }
        }
    }
}

export component NetflixStrip inherits Card {
    property <[TitleData]> items: NetflixState.tab == 0 ? NetflixState.shows : NetflixState.films;
    /// A video docked here takes the row; Now Watching steps aside for it.
    property <bool> docked: PlayerState.active && PlayerState.site == "netflix";
    property <bool> watching: HudState.watching && HudState.watching-site == "netflix" && !root.docked;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;
        // On a short bar a playing video needs the whole strip; the tabs come back when it stops.
        if !((root.watching || root.docked) && root.height < 84px) : StripHeader {
            labels: ["Shows", "Films"];
            index <=> NetflixState.tab;
            label: NetflixState.week == "" ? "Top 10" : "Top 10 · " + NetflixState.week;
        }
        if root.watching : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            NowWatching { site: "netflix"; compact: true; }
        }
        if root.docked : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 10px;
            PlayerSlot { width: self.height * 16 / 9; }
            VerticalLayout {
                alignment: center;
                PlayerBar { }
            }
        }
        if !root.watching && !root.docked && root.items.length > 0 : HScroll {
            vertical-stretch: 1;
            content-width: root.items.length * 222px - 8px;
            for t[i] in root.items : TitleTile { x: i * 222px; height: parent.height; item: t; }
        }
        if !root.watching && !root.docked && root.items.length == 0 : Placeholder { vertical-stretch: 1; centered: false; text: NetflixState.placeholder; }
    }
}

export component NetflixPanel inherits Card {
    property <bool> docked: PlayerState.active && PlayerState.site == "netflix";
    property <[TitleData]> items: NetflixState.tab == 0 ? NetflixState.shows : NetflixState.films;
    VerticalLayout {
        padding: 16px;
        padding-bottom: 10px;
        spacing: 6px;
        PanelHeader {
            title: "Netflix";
            labels: ["Shows", "Films"];
            index <=> NetflixState.tab;
            caption: NetflixState.week == "" ? "Global Top 10" : "Global Top 10 · " + NetflixState.week;
        }
        if root.docked : VerticalLayout {
            spacing: 4px;
            PlayerSlot { height: self.width * 9 / 16; }
            PlayerBar { }
        }
        if !root.docked : NowWatching { site: "netflix"; }
        if root.items.length > 0 : FeedScroll {
            vertical-stretch: 1;
            min-height: 100px;
            preferred-height: 200px;
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                for t[i] in root.items : VerticalLayout {
                    if i > 0 : Rectangle { height: 1px; background: Theme.divider; }
                    TitleRow { item: t; }
                }
            }
        }
        if root.items.length == 0 : VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding-top: 6px;
            padding-bottom: 6px;
            Placeholder { centered: false; text: NetflixState.placeholder; }
        }
    }
}
