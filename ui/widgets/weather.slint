import { Theme } from "../theme.slint";
import { Card, Overline, RangeBar } from "../components.slint";
import { HudState, Condition } from "../state.slint";
import { WeatherIcon } from "../weather-icon.slint";

/// Top HUD: current conditions at a glance, plus a three-day peek when there's room.
export component WeatherStrip inherits Card {
    in property <bool> compact;
    width: !HudState.weather-ready ? 236px : root.compact ? 256px : 384px;

    if HudState.weather-ready : HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;

        WeatherIcon {
            width: 38px;
            height: 38px;
            y: (parent.height - self.height) / 2;
            condition: HudState.condition;
            day: HudState.is-day;
        }
        VerticalLayout {
            alignment: center;
            spacing: -2px;
            horizontal-stretch: 1;
            min-width: 56px;
            Text { text: HudState.temperature; font-family: Theme.display-font; font-size: 26px; font-weight: 600; color: Theme.text; }
            Text { text: HudState.location; font-size: 12px; color: Theme.text2; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            padding-left: 4px;
            horizontal-stretch: 1;
            min-width: 72px;
            Text { text: HudState.description; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: HudState.high-low; font-size: 12px; color: Theme.text2; }
            if HudState.weather-status != "" : Text { text: HudState.weather-status; font-size: 11px; color: Theme.text3; }
        }
        if !root.compact : HorizontalLayout {
            padding-left: 8px;
            spacing: 2px;
            horizontal-stretch: 0;
            Rectangle { width: 1px; background: Theme.divider; }
            for day in HudState.upcoming : VerticalLayout {
                width: 40px;
                alignment: center;
                spacing: 1px;
                Text { text: day.label; font-size: 11px; color: Theme.text2; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    WeatherIcon { width: 18px; height: 18px; condition: day.condition; }
                }
                Text { text: day.high; font-size: 12px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
            }
        }
    }

    if !HudState.weather-ready : HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        WeatherIcon {
            width: 32px;
            height: 32px;
            y: (parent.height - self.height) / 2;
            condition: Condition.partly-cloudy;
            opacity: 0.55;
        }
        VerticalLayout {
            alignment: center;
            Text { text: "Weather"; font-size: 13px; font-weight: 600; color: Theme.text; }
            Text { text: HudState.weather-placeholder; font-size: 12px; color: Theme.text2; wrap: word-wrap; max-width: 170px; }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { HudState.weather-clicked(); }
        }
    }
}

/// Sidebar: one compact line of conditions, an optional hourly strip (tall screens only) and the
/// multi-day forecast with range bars.
export component WeatherPanel inherits Card {
    in property <bool> show-hourly;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 10px;
        spacing: 0;

        if HudState.weather-ready : VerticalLayout {
            spacing: 0;
            HorizontalLayout {
                spacing: 10px;
                WeatherIcon {
                    width: 40px;
                    height: 40px;
                    y: (parent.height - self.height) / 2;
                    condition: HudState.condition;
                    day: HudState.is-day;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: -3px;
                    Text { text: HudState.temperature; font-family: Theme.display-font; font-size: 30px; font-weight: 600; color: Theme.text; }
                    Text { text: HudState.location; font-size: 12px; color: Theme.text2; overflow: elide; }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: HudState.description; font-size: 13px; font-weight: 600; color: Theme.text; horizontal-alignment: right; overflow: elide; }
                    Text { text: HudState.weather-status != "" ? HudState.weather-status : HudState.high-low; font-size: 12px; color: Theme.text2; horizontal-alignment: right; }
                }
            }

            if root.show-hourly : HorizontalLayout {
                padding-top: 10px;
                for hour in HudState.hourly : VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: hour.label; font-size: 11px; color: Theme.text2; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        WeatherIcon { width: 20px; height: 20px; condition: hour.condition; day: hour.day; }
                    }
                    Text { text: hour.temp; font-size: 12px; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                }
            }

            Rectangle { height: 8px; }
            Rectangle { height: 1px; background: Theme.divider; }
            Rectangle { height: 3px; }

            for day in HudState.daily : HorizontalLayout {
                height: 22px;
                spacing: 6px;
                Text { text: day.label; width: 44px; font-size: 13px; color: Theme.text; vertical-alignment: center; }
                WeatherIcon { width: 17px; height: 17px; y: (parent.height - self.height) / 2; condition: day.condition; }
                Text { text: day.low; width: 30px; font-size: 12px; color: Theme.text3; horizontal-alignment: right; vertical-alignment: center; }
                Rectangle {
                    horizontal-stretch: 1;
                    RangeBar {
                        width: parent.width;
                        y: (parent.height - self.height) / 2;
                        low: day.low-pos;
                        high: day.high-pos;
                        marker: day.marker-pos;
                        has-marker: day.has-marker;
                        low-color: day.low-color;
                        high-color: day.high-color;
                    }
                }
                Text { text: day.high; width: 30px; font-size: 13px; font-weight: 600; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
            }
        }

        if !HudState.weather-ready : HorizontalLayout {
            spacing: 12px;
            WeatherIcon { width: 36px; height: 36px; condition: Condition.partly-cloudy; opacity: 0.55; }
            VerticalLayout {
                alignment: center;
                Text { text: "Weather"; font-size: 13px; font-weight: 600; color: Theme.text; }
                Text { text: HudState.weather-placeholder; font-size: 12px; color: Theme.text2; wrap: word-wrap; }
            }
        }
    }

    if !HudState.weather-ready : TouchArea {
        mouse-cursor: pointer;
        clicked => { HudState.weather-clicked(); }
    }
}