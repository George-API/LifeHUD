import { Theme } from "../theme.slint";
import { Card, IconButton, Overline, PillButton, PlayButton, SlimProgress } from "../components.slint";
import { HudState } from "../state.slint";

component Artwork inherits Rectangle {
    border-radius: 8px;
    clip: true;
    background: Theme.fill;

    if !HudState.has-artwork : Image {
        source: @image-url("../icons/music.svg");
        width: parent.width * 0.38;
        colorize: Theme.text3;
    }
    if HudState.has-artwork : Image {
        width: parent.width;
        height: parent.height;
        source: HudState.artwork;
        image-fit: cover;
    }
}

component SourceLabel {
    HorizontalLayout {
        spacing: 5px;
        // Official Spotify icon, kept in Spotify Green per their brand guidelines (no colorize).
        if HudState.is-spotify : Image {
            source: @image-url("../icons/spotify.svg");
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            accessible-role: image;
            accessible-label: "Spotify";
        }
        Overline { text: HudState.media-source; }
    }
}

/// A soft wash of the album art's colour behind the card.
component Glow inherits Rectangle {
    border-radius: 13px;
    background: @linear-gradient(90deg, HudState.glow 0%, HudState.glow.with-alpha(HudState.glow.alpha * 0.25) 55%, transparent 100%);
    animate background { duration: 400ms; }
}

/// Right-click anywhere on the card (outside the buttons) for saved playlists.
component PlaylistMenuArea inherits TouchArea {
    pointer-event(e) => {
        if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
            HudState.show-playlists();
        }
    }
}

/// The player's own volume (its slider in the Windows mixer, not the system volume): a speaker
/// that mutes and unmutes, a slider that follows the drag, and the mouse wheel in 5% steps.
component VolumeRow inherits TouchArea {
    /// Room on each side, so the bar lines up with the timeline above it.
    in property <length> lead: 18px;
    in property <length> trail: 0px;
    property <float> before-mute: 0.5;
    height: 18px;
    accessible-role: slider;
    accessible-label: "Volume";
    accessible-value: round(HudState.volume * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.nudge(0.05); }
    accessible-action-decrement => { root.nudge(-0.05); }

    function apply(v: float) {
        HudState.volume = clamp(v, 0, 1);
        HudState.set-volume(HudState.volume);
    }
    function nudge(d: float) {
        // Snap to the 5% grid so repeated steps land on round numbers.
        root.apply(round((HudState.volume + d) * 20) / 20);
    }
    scroll-event(e) => {
        if e.delta-y > 0 {
            root.nudge(0.05);
        } else if e.delta-y < 0 {
            root.nudge(-0.05);
        }
        accept
    }

    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: root.lead;
            speaker := Image {
                x: 0;
                width: 14px;
                height: 14px;
                source: HudState.volume <= 0.001 ? @image-url("../icons/volume-mute.svg") : @image-url("../icons/volume.svg");
                colorize: mute.has-hover ? Theme.text : Theme.text3;
            }
            mute := TouchArea {
                width: 18px;
                x: 0;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: HudState.volume <= 0.001 ? "Unmute" : "Mute";
                accessible-action-default => { self.clicked(); }
                clicked => {
                    if HudState.volume > 0.001 {
                        root.before-mute = HudState.volume;
                        root.apply(0);
                    } else {
                        root.apply(root.before-mute > 0.001 ? root.before-mute : 0.5);
                    }
                }
            }
        }
        SlimProgress {
            y: (parent.height - self.height) / 2;
            value: HudState.volume;
            color: Theme.text2;
            animated: false;
            seekable: true;
            live: true;
            seek(f) => { root.apply(f); }
            scrub(f) => { root.apply(f); }
        }
        if root.trail > 0 : Rectangle { width: root.trail; }
    }
}

export component MediaStrip inherits Card {
    /// The speaker button swaps the title and timeline for the volume slider (no room for both).
    property <bool> show-volume: HudState.volume-open && HudState.volume-available;
    width: 372px;
    Glow { }
    PlaylistMenuArea { }
    HorizontalLayout {
        padding: 10px;
        padding-right: 12px;
        spacing: 12px;

        // On short bars the art shrinks to fit and the artist line steps aside, so nothing is clipped.
        Artwork {
            width: min(56px, root.height - 20px);
            height: self.width;
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            SourceLabel { }
            if !root.show-volume : Text { text: HudState.track-title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
            if !root.show-volume && root.height >= 70px : Text { text: HudState.track-artist; font-size: 12px; color: Theme.text2; overflow: elide; }
            if !root.show-volume && HudState.has-timeline : VerticalLayout {
                padding-top: 6px;
                SlimProgress { value: HudState.media-progress; animated: false; seekable: HudState.can-seek; seek(f) => { HudState.seek(f); } }
            }
            if root.show-volume : VerticalLayout {
                padding-top: 4px;
                VolumeRow { lead: 16px; min-width: 92px; }
            }
        }

        if HudState.has-media : HorizontalLayout {
            alignment: center;
            spacing: 4px;
            IconButton {
                y: (parent.height - self.height) / 2;
                size: min(36px, root.height - 22px);
                icon-size: self.size * 0.53;
                icon: @image-url("../icons/previous.svg");
                label: "Previous track";
                enabled: HudState.can-previous;
                clicked => { HudState.previous-track(); }
            }
            PlayButton {
                y: (parent.height - self.height) / 2;
                size: min(46px, root.height - 18px);
                playing: HudState.is-playing;
                clicked => { HudState.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: min(36px, root.height - 22px);
                icon-size: self.size * 0.53;
                icon: @image-url("../icons/next.svg");
                label: "Next track";
                enabled: HudState.can-next;
                clicked => { HudState.next-track(); }
            }
            if HudState.volume-available : IconButton {
                y: (parent.height - self.height) / 2;
                size: min(28px, root.height - 30px);
                icon-size: self.size * 0.58;
                icon: HudState.volume <= 0.001 ? @image-url("../icons/volume-mute.svg") : @image-url("../icons/volume.svg");
                label: root.show-volume ? "Hide volume" : "Volume";
                clicked => { HudState.volume-open = !HudState.volume-open; }
            }
        }
        if !HudState.has-media : VerticalLayout {
            alignment: center;
            PillButton { text: "Open Spotify"; clicked => { HudState.open-spotify(); } }
        }
    }
}

/// Sidebar: art and title, an inline timeline, and controls tucked directly beneath.
export component MediaPanel inherits Card {
    Glow { }
    PlaylistMenuArea { }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 8px;
        spacing: 0;

        HorizontalLayout {
            spacing: 12px;
            Artwork { width: 52px; height: 52px; }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                SourceLabel { }
                Text { text: HudState.track-title; font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
                Text { text: HudState.track-artist; font-size: 12px; color: Theme.text2; overflow: elide; }
            }
        }

        if HudState.has-timeline : HorizontalLayout {
            padding-top: 10px;
            spacing: 8px;
            Text { text: HudState.elapsed; width: 34px; font-size: 11px; color: Theme.text3; vertical-alignment: center; }
            SlimProgress { y: (parent.height - self.height) / 2; value: HudState.media-progress; animated: false; seekable: HudState.can-seek; seek(f) => { HudState.seek(f); } }
            Text { text: HudState.remaining; width: 38px; font-size: 11px; color: Theme.text3; horizontal-alignment: right; vertical-alignment: center; }
        }

        if HudState.has-media : HorizontalLayout {
            padding-top: 4px;
            alignment: center;
            spacing: 12px;
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 38px;
                icon-size: 20px;
                icon: @image-url("../icons/previous.svg");
                label: "Previous track";
                enabled: HudState.can-previous;
                clicked => { HudState.previous-track(); }
            }
            PlayButton {
                size: 48px;
                playing: HudState.is-playing;
                clicked => { HudState.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 38px;
                icon-size: 20px;
                icon: @image-url("../icons/next.svg");
                label: "Next track";
                enabled: HudState.can-next;
                clicked => { HudState.next-track(); }
            }
        }
        // Lines up with the timeline: the speaker sits where the elapsed time is.
        if HudState.has-media && HudState.volume-available : HorizontalLayout {
            padding-top: 2px;
            padding-bottom: 4px;
            VolumeRow { lead: 34px; trail: 38px; }
        }
        if !HudState.has-media : HorizontalLayout {
            padding-top: 10px;
            padding-bottom: 4px;
            alignment: start;
            PillButton { text: "Open Spotify"; clicked => { HudState.open-spotify(); } }
        }
    }
}