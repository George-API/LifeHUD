import { Theme } from "../theme.slint";
import { Card, IconButton, Overline, PillButton, PlayButton, SlimProgress } from "../components.slint";
import { HudState } from "../state.slint";

component Artwork inherits Rectangle {
    border-radius: 8px;
    clip: true;
    background: Theme.fill;

    if !HudState.has-artwork : Image {
        source: @image-url("../icons/music.svg");
        width: parent.width * 0.38;
        colorize: Theme.text3;
    }
    if HudState.has-artwork : Image {
        width: parent.width;
        height: parent.height;
        source: HudState.artwork;
        image-fit: cover;
    }
}

component SourceLabel {
    HorizontalLayout {
        spacing: 5px;
        if HudState.is-spotify : Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: #1ed760;
        }
        Overline { text: HudState.media-source; }
    }
}

/// A soft wash of the album art's colour behind the card.
component Glow inherits Rectangle {
    border-radius: 13px;
    background: @linear-gradient(90deg, HudState.glow 0%, HudState.glow.with-alpha(HudState.glow.alpha * 0.25) 55%, transparent 100%);
    animate background { duration: 400ms; }
}

export component MediaStrip inherits Card {
    width: 372px;
    Glow { }
    HorizontalLayout {
        padding: 10px;
        padding-right: 12px;
        spacing: 12px;

        Artwork { width: 56px; height: 56px; y: (parent.height - self.height) / 2; }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            SourceLabel { }
            Text { text: HudState.track-title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: HudState.track-artist; font-size: 11.5px; color: Theme.text2; overflow: elide; }
            if HudState.has-timeline : VerticalLayout {
                padding-top: 6px;
                SlimProgress { value: HudState.media-progress; }
            }
        }

        if HudState.has-media : HorizontalLayout {
            alignment: center;
            spacing: 4px;
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 30px;
                icon-size: 16px;
                icon: @image-url("../icons/previous.svg");
                enabled: HudState.can-previous;
                clicked => { HudState.previous-track(); }
            }
            PlayButton {
                y: (parent.height - self.height) / 2;
                size: 38px;
                playing: HudState.is-playing;
                clicked => { HudState.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 30px;
                icon-size: 16px;
                icon: @image-url("../icons/next.svg");
                enabled: HudState.can-next;
                clicked => { HudState.next-track(); }
            }
        }
        if !HudState.has-media : VerticalLayout {
            alignment: center;
            PillButton { text: "Open Spotify"; clicked => { HudState.open-spotify(); } }
        }
    }
}

/// Sidebar: art and title, an inline timeline, and controls tucked directly beneath.
export component MediaPanel inherits Card {
    Glow { }
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 8px;
        spacing: 0;

        HorizontalLayout {
            spacing: 12px;
            Artwork { width: 52px; height: 52px; }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                SourceLabel { }
                Text { text: HudState.track-title; font-size: 13.5px; font-weight: 600; color: Theme.text; overflow: elide; }
                Text { text: HudState.track-artist; font-size: 12px; color: Theme.text2; overflow: elide; }
            }
        }

        if HudState.has-timeline : HorizontalLayout {
            padding-top: 10px;
            spacing: 8px;
            Text { text: HudState.elapsed; width: 34px; font-size: 10.5px; color: Theme.text3; vertical-alignment: center; }
            SlimProgress { y: (parent.height - self.height) / 2; value: HudState.media-progress; }
            Text { text: HudState.remaining; width: 38px; font-size: 10.5px; color: Theme.text3; horizontal-alignment: right; vertical-alignment: center; }
        }

        if HudState.has-media : HorizontalLayout {
            padding-top: 4px;
            alignment: center;
            spacing: 12px;
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 34px;
                icon-size: 18px;
                icon: @image-url("../icons/previous.svg");
                enabled: HudState.can-previous;
                clicked => { HudState.previous-track(); }
            }
            PlayButton {
                size: 42px;
                playing: HudState.is-playing;
                clicked => { HudState.play-pause(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                size: 34px;
                icon-size: 18px;
                icon: @image-url("../icons/next.svg");
                enabled: HudState.can-next;
                clicked => { HudState.next-track(); }
            }
        }
        if !HudState.has-media : HorizontalLayout {
            padding-top: 10px;
            padding-bottom: 4px;
            alignment: start;
            PillButton { text: "Open Spotify"; clicked => { HudState.open-spotify(); } }
        }
    }
}