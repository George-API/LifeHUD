// Sports: scores for the leagues you follow, your teams first. The Top HUD gets a ticker of game
// tiles; the Sidebar gets a sectioned list (Your teams · Live · Upcoming · Final) and headlines.

import { Theme } from "../theme.slint";
import { Card } from "../components.slint";
import { GameData, LinkData, SportsState, TeamLine } from "../feeds/state.slint";
import { FeedScroll, HScroll, LinkList, LiveDot, PanelHeader, Placeholder, SectionLabel, StripHeader, StripRows, Thumb, Tone } from "../feeds/common.slint";

component Logo inherits Rectangle {
    in property <TeamLine> team;
    in property <length> size: 18px;
    width: root.size;
    height: root.size;
    if root.team.has-logo : Image {
        width: parent.width;
        height: parent.height;
        source: Theme.dark && root.team.has-logo-dark ? root.team.logo-dark : root.team.logo;
        image-fit: contain;
    }
    // No logo yet: the abbreviation's first letter in a soft disc.
    if !root.team.has-logo : Rectangle {
        border-radius: self.width / 2;
        background: Theme.fill;
        Text { text: root.team.abbr == "" ? "" : "•"; font-size: 10px; color: Theme.text3; }
    }
}

component TeamScore {
    in property <TeamLine> team;
    in property <bool> show-score;
    in property <bool> full-name;
    in property <bool> show-record: true;
    in property <length> logo-size: 18px;
    HorizontalLayout {
        spacing: 7px;
        Logo { team: root.team; size: root.logo-size; y: (parent.height - self.height) / 2; }
        Text {
            text: root.full-name ? root.team.name : root.team.abbr;
            font-size: root.full-name ? 13px : 12.5px;
            font-weight: root.team.winner ? 700 : 600;
            color: root.team.dim ? Theme.text3 : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: root.full-name ? 0 : 1;
            min-width: root.full-name ? 36px : 0px;
        }
        if root.full-name && root.show-record : Text {
            text: root.team.record;
            font-size: 11px;
            color: Theme.text3;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.show-score : Text {
            text: root.team.score;
            font-size: root.full-name ? 15px : 13px;
            font-weight: root.team.winner || !root.team.dim ? 700 : 500;
            color: root.team.dim ? Theme.text3 : Theme.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 22px;
        }
    }
}

component Status {
    in property <GameData> game;
    in property <TextHorizontalAlignment> align: right;
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        HorizontalLayout {
            alignment: root.align == TextHorizontalAlignment.right ? end : start;
            spacing: 4px;
            if root.game.live : LiveDot { y: (parent.height - self.height) / 2; }
            Text {
                text: root.game.status;
                font-size: 11px;
                font-weight: 600;
                color: root.game.live ? Tone.live : root.game.done ? Theme.text2 : Theme.text;
                horizontal-alignment: root.align;
                overflow: elide;
            }
        }
        if root.game.sub != "" : Text {
            text: root.game.sub;
            font-size: 11px;
            color: Theme.text3;
            horizontal-alignment: root.align;
            overflow: elide;
        }
    }
}

/// A Top HUD tile: two team lines and the game's status.
component GameTile {
    in property <GameData> game;
    accessible-role: button;
    accessible-label: root.game.live || root.game.done
        ? root.game.first.name + " " + root.game.first.score + ", " + root.game.second.name + " " + root.game.second.score + ", " + (root.game.live ? "live, " : "") + root.game.status + " " + root.game.sub
        : root.game.first.name + " versus " + root.game.second.name + ", " + root.game.status + " " + root.game.sub;
    accessible-action-default => { SportsState.open(root.game.url); }
    /// The shortest Top HUD leaves no room for two team lines.
    property <bool> compact: root.height < 32px;
    property <bool> scored: root.game.live || root.game.done;
    width: 172px;

    Rectangle {
        border-radius: 9px;
        background: ta.has-hover ? Theme.fill-hover : Theme.fill;
        border-width: root.game.favorite ? 1px : 0px;
        border-color: Theme.accent.with-alpha(0.55);
        animate background { duration: 120ms; }
    }
    if root.compact : HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        Text { text: root.game.first.abbr; font-size: 12px; font-weight: 600; color: root.game.first.dim ? Theme.text3 : Theme.text; vertical-alignment: center; }
        Text {
            text: root.scored ? root.game.first.score + "–" + root.game.second.score : "·";
            font-size: 12px;
            font-weight: 700;
            color: root.scored ? Theme.text : Theme.text3;
            vertical-alignment: center;
        }
        Text { text: root.game.second.abbr; font-size: 12px; font-weight: 600; color: root.game.second.dim ? Theme.text3 : Theme.text; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if root.game.live : LiveDot { y: (parent.height - self.height) / 2; }
        Text {
            text: root.game.status;
            font-size: 11px;
            font-weight: 600;
            color: root.game.live ? Tone.live : root.game.done ? Theme.text2 : Theme.text;
            vertical-alignment: center;
        }
    }
    if !root.compact : HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: space-around;
            horizontal-stretch: 1;
            TeamScore { team: root.game.first; show-score: root.game.live || root.game.done; logo-size: min(18px, (root.height - 10px) / 2); }
            TeamScore { team: root.game.second; show-score: root.game.live || root.game.done; logo-size: min(18px, (root.height - 10px) / 2); }
        }
        Rectangle { width: 1px; background: Theme.divider; }
        Status { game: root.game; width: 58px; align: left; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { SportsState.open(root.game.url); }
    }
}

/// A Sidebar row: full team names, records and scores, with the status on the right.
component GameRow {
    in property <GameData> game;
    accessible-role: button;
    accessible-label: root.game.live || root.game.done
        ? root.game.first.name + " " + root.game.first.score + ", " + root.game.second.name + " " + root.game.second.score + ", " + (root.game.live ? "live, " : "") + root.game.status + " " + root.game.sub
        : root.game.first.name + " versus " + root.game.second.name + ", " + root.game.status + " " + root.game.sub;
    accessible-action-default => { SportsState.open(root.game.url); }
    in property <bool> narrow;
    height: 50px;

    Rectangle {
        x: -6px;
        width: root.width + 12px;
        border-radius: 8px;
        background: ta.has-hover ? Theme.fill : transparent;
        animate background { duration: 120ms; }
    }
    if root.game.favorite : Rectangle {
        x: -6px;
        y: 9px;
        width: 3px;
        height: root.height - 18px;
        border-radius: 1.25px;
        background: Theme.accent;
    }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            TeamScore { team: root.game.first; show-score: root.game.live || root.game.done; full-name: true; show-record: !root.narrow; height: 19px; }
            TeamScore { team: root.game.second; show-score: root.game.live || root.game.done; full-name: true; show-record: !root.narrow; height: 19px; }
        }
        VerticalLayout {
            width: 70px;
            alignment: center;
            spacing: 2px;
            Text { text: root.game.league; font-size: 10px; font-weight: 600; letter-spacing: 0.4px; color: Theme.text3; horizontal-alignment: right; }
            Status { game: root.game; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { SportsState.open(root.game.url); }
    }
}

export component SportsStrip inherits Card {
    property <bool> empty: SportsState.tab == 0 ? SportsState.games.length == 0 : SportsState.stories.length == 0;
    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;
        StripHeader {
            labels: ["Scores", "News"];
            index <=> SportsState.tab;
            label: SportsState.live-count > 0 && SportsState.tab == 0 ? SportsState.live-count + " live" : SportsState.label;
            live: SportsState.live-count > 0 && SportsState.tab == 0;
        }
        if SportsState.tab == 0 && !root.empty : HScroll {
            vertical-stretch: 1;
            content-width: SportsState.games.length * 180px - 8px;
            for g[i] in SportsState.games : GameTile { x: i * 180px; height: parent.height; game: g; }
        }
        if SportsState.tab == 1 && !root.empty : LinkList {
            vertical-stretch: 1;
            // Exactly three rows (and their two 1px dividers) fill the strip, so none peeks in below.
            row-height: StripRows.row-height(self.height);
            items: SportsState.stories;
            open(u) => { SportsState.open(u); }
        }
        if root.empty : Placeholder {
            vertical-stretch: 1;
            centered: false;
            text: SportsState.tab == 0 ? SportsState.placeholder : SportsState.news-placeholder;
            action: SportsState.label == "" ? "Choose leagues" : "";
            act => { SportsState.customize(); }
        }
    }
}

export component SportsPanel inherits Card {
    in property <bool> narrow;
    property <bool> empty: SportsState.tab == 0 ? SportsState.games.length == 0 : SportsState.stories.length == 0;
    VerticalLayout {
        padding: 16px;
        padding-bottom: 10px;
        spacing: 6px;
        PanelHeader {
            title: "Sports";
            labels: ["Scores", "News"];
            index <=> SportsState.tab;
            caption: SportsState.live-count > 0 && SportsState.tab == 0 ? SportsState.live-count + " live now" : SportsState.label;
            live: SportsState.live-count > 0 && SportsState.tab == 0;
        }
        if SportsState.tab == 0 && !root.empty : FeedScroll {
            vertical-stretch: 1;
            min-height: 100px;
            preferred-height: 180px;
            content-height: games.preferred-height;
            games := VerticalLayout {
                alignment: start;
                for g[i] in SportsState.games : VerticalLayout {
                    if g.header != "" : SectionLabel { text: g.header; }
                    if g.header == "" && i > 0 : Rectangle { height: 1px; background: Theme.divider; }
                    GameRow { game: g; narrow: root.narrow; }
                }
            }
        }
        if SportsState.tab == 1 && !root.empty : LinkList {
            vertical-stretch: 1;
            min-height: 100px;
            preferred-height: 180px;
            rich: true;
            items: SportsState.stories;
            fallback: @image-url("../icons/sports.svg");
            open(u) => { SportsState.open(u); }
        }
        if root.empty : VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding-top: 6px;
            padding-bottom: 6px;
            Placeholder {
                centered: false;
                text: SportsState.tab == 0 ? SportsState.placeholder : SportsState.news-placeholder;
                action: SportsState.label == "" ? "Choose leagues" : "";
                act => { SportsState.customize(); }
            }
        }
    }
}
