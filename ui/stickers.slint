// Die-cut sticker art for the mood themes. Each set has four motifs (ui/stickers/<set>-*.svg),
// arranged with accents into one large, irregular repeating tile by tools/gen_sticker_tiles.py.

import { Theme } from "theme.slint";

/// A quiet, embossed-looking pattern of the theme's motifs: tinted to the theme ink at very low
/// opacity, staggered like a brick bond, each motif slightly turned. Clipped by its card.
///
/// The tile comes pre-rasterized from Rust (src/stickers.rs, at 2×) and is laid out as a few plain
/// bitmaps: the software renderer re-rasterizes an SVG on every repaint, and the tiles are big and
/// mask-heavy enough that a card's once-a-second music progress repaint paid ~4 ms for each one.
/// Anchored like a tiled Image (centred by default), so the pattern sits exactly where it did.
export component StickerPattern inherits Rectangle {
    in property <int> set;
    in property <color> ink;
    in property <float> strength: 0.06;
    in property <ImageHorizontalAlignment> horizontal-alignment: center;
    in property <ImageVerticalAlignment> vertical-alignment: center;

    property <image> tile: Theme.sticker-tile(root.set);
    // Logical tile size: the bitmap is rendered at 2× (SCALE in src/stickers.rs).
    property <length> tw: root.tile.width * 1px / 2;
    property <length> th: root.tile.height * 1px / 2;
    // Offset of the first (top-left) tile, in (-tile, 0].
    property <length> ox: root.tw <= 0 ? 0 : root.horizontal-alignment == ImageHorizontalAlignment.left ? 0
        : root.first((root.horizontal-alignment == ImageHorizontalAlignment.center ? 0.5 : 1) * (root.width - root.tw), root.tw);
    property <length> oy: root.th <= 0 ? 0 : root.vertical-alignment == ImageVerticalAlignment.top ? 0
        : root.first((root.vertical-alignment == ImageVerticalAlignment.center ? 0.5 : 1) * (root.height - root.th), root.th);
    property <int> cols: root.tw <= 0 ? 0 : ceil((root.width - root.ox) / root.tw);
    property <int> rows: root.th <= 0 ? 0 : ceil((root.height - root.oy) / root.th);

    /// Steps an anchored tile position back to the first tile that reaches the left/top edge.
    pure function first(at: length, size: length) -> length {
        at - ceil(at / size) * size
    }

    clip: true;

    for r in root.rows : Rectangle {
        y: root.oy + r * root.th;
        height: root.th;
        for c in root.cols : Image {
            x: root.ox + c * root.tw;
            width: root.tw;
            height: root.th;
            source: root.tile;
            image-fit: fill;
            colorize: root.ink;
            opacity: root.strength;
        }
    }
}
